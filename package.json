{
  "name": "corpus",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:up": "supabase migration up --local",
    "db:verify": "./scripts/verify-migrations.sh",
    "db:port": "node --disable-warning=ExperimentalWarning scripts/port-sqlite.mjs",
    "db:gate": "tsx scripts/verify-port.mts",
    "design:contrast": "node scripts/contrast.mjs",
    "test:recovery": "NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321 ANTHROPIC_API_KEY=$(grep '^ANTHROPIC_API_KEY' .env.local | cut -d= -f2-) SUPABASE_SECRET_KEY=$(supabase status --output json | python3 -c \"import sys,json;print(json.load(sys.stdin)['SERVICE_ROLE_KEY'])\") tsx scripts/test-recovery.mts",
    "test": "vitest run",
    "check:dashboard": "tsx scripts/check-dashboard.mts",
    "check:access": "node scripts/check-access.mjs",
    "reconcile:now": "NEXT_PUBLIC_SUPABASE_URL=$(grep '^NEXT_PUBLIC_SUPABASE_URL=' .env.local | cut -d= -f2-) SUPABASE_SECRET_KEY=$(grep '^SUPABASE_SECRET_KEY=' .env.local | cut -d= -f2-) ANTHROPIC_API_KEY=$(grep '^ANTHROPIC_API_KEY' .env.local | cut -d= -f2-) tsx scripts/reconcile-now.mts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.120.0",
    "@base-ui/react": "^1.7.0",
    "@netlify/blobs": "^11.0.1",
    "@netlify/functions": "^6.0.0",
    "@serwist/next": "^9.5.12",
    "@supabase/ssr": "^0.12.4",
    "@supabase/supabase-js": "^2.112.3",
    "browser-image-compression": "^2.0.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "idb": "^8.0.3",
    "lucide-react": "^1.33.0",
    "next": "16.3.2",
    "next-themes": "^0.4.6",
    "postgres": "^3.4.9",
    "react": "19.2.8",
    "react-day-picker": "^10.0.1",
    "react-dom": "19.2.8",
    "recharts": "^3.10.1",
    "server-only": "^0.0.1",
    "serwist": "^9.5.12",
    "shadcn": "^4.19.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@netlify/plugin-nextjs": "^5.15.13",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "culori": "^4.0.2",
    "eslint": "^9",
    "eslint-config-next": "16.3.2",
    "microdiff": "^1.6.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.12",
    "typescript": "^5",
    "vitest": "^4.1.11"
  },
  "packageManager": "pnpm@11.1.3"
}
